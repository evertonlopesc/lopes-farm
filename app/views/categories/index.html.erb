<h1>Categorias</h1>
<%= link_to "Nova Categoria", new_category_path %>

<table>
  <thead>
    <tr>
      <th>Nome</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.name %></td>
        <td>
          <%= link_to "Ver", category %>
          <%= link_to "Editar", edit_category_path(category) %>
          <%= link_to "Remover", category, data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

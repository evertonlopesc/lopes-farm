<div class="mb-6">
  <h1 class="text-2xl font-bold mb-4">🏆 Ranking — Melhores itens para vender</h1>

  <%= form_with url: ranking_items_path, method: :get, class: "flex gap-3 items-center" do |f| %>
    <%= f.collection_select :category_id, @categories, :id, :name,
                            { include_blank: "Todas as categorias", selected: params[:category_id] },
                            { class: "border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-green-500" } %>
    <%= f.submit "Filtrar", class: "bg-green-700 text-white px-4 py-2 rounded hover:bg-green-800 cursor-pointer" %>
  <% end %>
</div>

<% if @results.empty? %>
  <p class="text-gray-500">Nenhum item encontrado.</p>
<% else %>
  <table class="w-full bg-white rounded shadow text-sm">
    <thead class="bg-gray-100 text-left">
      <tr>
        <th class="px-4 py-3">#</th>
        <th class="px-4 py-3">Item</th>
        <th class="px-4 py-3">Categoria</th>
        <th class="px-4 py-3">Tempo total</th>
        <th class="px-4 py-3">Componentes</th>
        <th class="px-4 py-3">Custo total</th>
        <th class="px-4 py-3">Preço</th>
        <th class="px-4 py-3">Margem</th>
      </tr>
    </thead>
    <tbody>
      <% @results.each_with_index do |result, index| %>
        <tr class="border-t hover:bg-gray-50">
          <td class="px-4 py-3 font-bold text-gray-400"><%= index + 1 %></td>
          <td class="px-4 py-3 font-medium">
            <%= link_to result.item.name, result.item, class: "text-blue-600 hover:underline" %>
          </td>
          <td class="px-4 py-3"><%= result.item.category&.name || "—" %></td>
          <td class="px-4 py-3"><%= result.formatted_time %></td>
          <td class="px-4 py-3"><%= result.component_count %></td>
          <td class="px-4 py-3">R$ <%= result.total_cost %></td>
          <td class="px-4 py-3">R$ <%= result.item.sale_price %></td>
          <td class="px-4 py-3">
            <span class="<%= result.margin >= 0 ? 'text-green-700' : 'text-red-600' %> font-medium">
              <%= result.margin_percentage %>%
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

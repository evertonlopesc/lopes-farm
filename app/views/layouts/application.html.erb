<!DOCTYPE html>
<html>
  <head>
    <title>Lope's Farm</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-800 min-h-screen">
    <nav class="bg-green-800 text-white px-6 py-4 flex gap-6 items-center shadow">
      <%= link_to "🌾 Lope's Farm", root_path, class: "font-bold text-lg" %>
      <%= link_to "Itens", items_path, class: "hover:underline" %>
      <%= link_to "Categorias", categories_path, class: "hover:underline" %>
      <%= link_to "Ranking", ranking_items_path, class: "hover:underline" %>
    </nav>

    <main class="max-w-5xl mx-auto px-6 py-8">
      <% if notice.present? %>
        <div class="bg-green-100 border border-green-400 text-green-800 px-4 py-3 rounded mb-6">
          <%= notice %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>

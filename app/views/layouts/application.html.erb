<!DOCTYPE html>
<html>
  <head>
    <title>Lopes Farm</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav>
      <strong><%= link_to "🌾 Lopes Farm", root_path %></strong>
      <%= link_to "Itens", items_path %>
      <%= link_to "Categorias", categories_path %>
      <%= link_to "Ranking", ranking_items_path %>
    </nav>

    <main>
      <% if notice.present? %>
        <p id="notice"><%= notice %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
